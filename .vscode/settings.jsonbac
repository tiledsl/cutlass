{
    "cmake.configureEnvironment": {
        // 这会把你的 Conda bin 目录添加到 VS Code 插件的 PATH 头部
        "PATH": "/data/apps/miniforge3/envs/dev-cu130/bin:${env:PATH}", // dev-cu130
        "LD_LIBRARY_PATH": "/data/apps/miniforge3/envs/dev-cu130/lib:${env:LD_LIBRARY_PATH}"
    },
    "cmake.environment": {
        "PATH": "/data/apps/miniforge3/envs/dev-cu130/bin:${env:PATH}",
        "LD_LIBRARY_PATH": "/data/apps/miniforge3/envs/dev-cu130/lib:${env:LD_LIBRARY_PATH}"
    },
    "cmake.cmakePath": "/data/apps/miniforge3/envs/dev-cu130/bin/cmake",
    "cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",
    // "cmake.generator": "/data/apps/miniforge3/envs/dev-cu130/bin/ninja",
    "cmake.generator": "Ninja",
    // "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCUTLASS_NVCC_ARCHS=90a",
        "-DCMAKE_CXX_COMPILER=/data/apps/miniforge3/envs/dev-cu130/bin/clang++",
        "-DCMAKE_CUDA_HOST_COMPILER=/data/apps/miniforge3/envs/dev-cu130/bin/clang++",
        "-DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc",
        // "-DCUTLASS_ENABLE_TESTS=OFF",
        "-DCUTLASS_LIBRARY_KERNELS=all",
        "-DCUTLASS_UNITY_BUILD_ENABLED=ON",
        "-DCUTLASS_ENABLE_CUBLAS=ON",
        "-DCUTLASS_ENABLE_CUDNN=ON",
        "-DCUDNN_PATH=/ssd/apps/cudnn-linux-x86_64-9.14.0.64_cuda13-archive",
        
        "-DCMAKE_LINKER=/data/apps/miniforge3/envs/dev-cu130/bin/lld"

        // "-DCMAKE_CUDA_FLAGS_DEBUG=\"-G\""
    ],
    // 在这里添加 build 参数
    "cmake.buildArgs": [
        "-j 32" // 使用 "-j" 来利用所有核心
    ],
    "clangd.path": "/data/apps/miniforge3/envs/dev-cu130/bin/clangd",
    // 告诉 clangd 如何查询编译器 (clang++) 以获取默认的系统头文件路径
    "clangd.arguments": [
        "--query-driver=/data/apps/miniforge3/envs/dev-cu130/bin/clang++"
    ],
    "files.associations": {
        "*.go": "go",
        "expected": "cpp",
        "optional": "cpp",
        "regex": "cpp",
        "type_traits": "cpp",
        "random": "cpp",
        "algorithm": "cpp",
        "any": "cpp",
        "atomic": "cpp",
        "bitset": "cpp",
        "charconv": "cpp",
        "chrono": "cpp",
        "cmath": "cpp",
        "compare": "cpp",
        "complex": "cpp",
        "deque": "cpp",
        "forward_list": "cpp",
        "list": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "vector": "cpp",
        "string_view": "cpp",
        "format": "cpp",
        "fstream": "cpp",
        "functional": "cpp",
        "future": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "mutex": "cpp",
        "numeric": "cpp",
        "ostream": "cpp",
        "ratio": "cpp",
        "sstream": "cpp",
        "streambuf": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "variant": "cpp",
        "*.inc": "cpp",
        "__string": "cpp",
        "array": "cpp",
        "span": "cpp",
        "bit": "cpp",
        "cassert": "cpp",
        "ccomplex": "cpp",
        "cctype": "cpp",
        "cerrno": "cpp",
        "cfenv": "cpp",
        "cfloat": "cpp",
        "cinttypes": "cpp",
        "ciso646": "cpp",
        "climits": "cpp",
        "clocale": "cpp",
        "concepts": "cpp",
        "condition_variable": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "map": "cpp",
        "set": "cpp",
        "exception": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
